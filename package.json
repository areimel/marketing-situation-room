{
  "name": "marketing-situation-room",
  "private": true,
  "version": "2.10.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck:api && tsc -p tsconfig.contract-tests.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p convex/tsconfig.json",
    "lint": "biome lint src/agency src/main.ts api/agency-headlines.js e2e/marketing-dashboard.spec.ts && npm run lint:boundaries",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "test:endpoints": "node --import tsx --test api/agency-headlines.test.mjs tests/*.test.mjs tests/*.test.mts",
    "test:e2e": "playwright test",
    "test:convex": "vitest run convex/__tests__/marketingAccess.test.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.37.0",
    "convex": "1.40.0",
    "jmespath": "0.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.63.0",
    "@types/jmespath": "0.15.2",
    "@types/node": "25.5.0",
    "convex-test": "0.0.43",
    "protobufjs": "7.6.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.1"
  }
}
